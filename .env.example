# CleanRoute AI — Environment Configuration Template
# Copy this file to .env and fill in the values for your environment.
# Never commit real credentials or secrets to version control.

# =========================================================================
# Django Core Settings
# =========================================================================
SECRET_KEY=
DEBUG=
ALLOWED_HOSTS=

# =========================================================================
# Database Configuration
# Production (Render / Cloud PostgreSQL): Provide DATABASE_URL
# =========================================================================
DATABASE_URL=

# Local Development PostgreSQL (used if DATABASE_URL is not set):
DATABASE_NAME=
DATABASE_USER=
DATABASE_PASSWORD=
DATABASE_HOST=
DATABASE_PORT=

# =========================================================================
# Frontend Integration & CORS
# =========================================================================
FRONTEND_URL=
CORS_ALLOWED_ORIGINS=
CSRF_TRUSTED_ORIGINS=

# =========================================================================
# External Services (Server-Side Only)
# =========================================================================
OPENROUTESERVICE_API_KEY=
